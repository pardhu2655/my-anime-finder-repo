        btn.classList.add('border-outline-variant', 'bg-surface-container');
        const textDiv = btn.querySelector('.font-label-md');
        if (textDiv) {
          textDiv.classList.remove('text-secondary', 'font-bold');
          textDiv.classList.add('text-on-surface');
          textDiv.textContent = textDiv.textContent.replace('* ', '');
        }
        const icon = btn.querySelector('.material-symbols-outlined');
        if (icon) {
          icon.classList.add('opacity-0');
          icon.textContent = 'radio_button_unchecked';
        }
      });

      button.classList.add('border-secondary-container', 'bg-secondary-container/10');
      button.classList.remove('border-outline-variant', 'bg-surface-container');
      const textDiv = button.querySelector('.font-label-md');
      if (textDiv) {
        textDiv.classList.add('text-secondary', 'font-bold');
        if (!textDiv.textContent.startsWith('*')) {
          textDiv.textContent = '* ' + textDiv.textContent;
        }
      }
      const icon = button.querySelector('.material-symbols-outlined');
      if (icon) {
        icon.classList.remove('opacity-0');
        icon.textContent = 'check_circle';
      }

      // Update Result Preview
      const data = recommendations[type] || recommendations.got;
      document.getElementById('match-title').textContent = data.title;
      document.getElementById('match-score').textContent = data.score;
      document.getElementById('match-genre').textContent = data.genre;
      document.getElementById('match-desc').textContent = data.desc;
      document.getElementById('match-rating').textContent = data.rating;
    }

