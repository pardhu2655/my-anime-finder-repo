        weirdness: "3 / 10 (QUIRKY ART STYLE)",
        pacing: "9 / 10 (DYNAMIC)",
        length: "25 EPS (2 SEASONS)"
      }
    ];

    let currentRouletteIndex = 0;

    function spinRoulette() {
      currentRouletteIndex = (currentRouletteIndex + 1) % roulettePool.length;
      const item = roulettePool[currentRouletteIndex];

      const titleEl = document.getElementById('roulette-title');
      const tagEl = document.getElementById('roulette-tag');
      const genreEl = document.getElementById('roulette-genre');
      const synEl = document.getElementById('roulette-synopsis');
      const weirdEl = document.getElementById('roulette-weirdness');
      const paceEl = document.getElementById('roulette-pacing');
      const lenEl = document.getElementById('roulette-length');

      // Visual spin flash effect
      titleEl.classList.add('opacity-30');
      setTimeout(() => {
        titleEl.textContent = item.title;
        tagEl.textContent = item.tag;
        genreEl.textContent = item.genre;
        synEl.textContent = item.synopsis;
        weirdEl.textContent = item.weirdness;
        paceEl.textContent = item.pacing;
        lenEl.textContent = item.length;
        titleEl.classList.remove('opacity-30');
      }, 150);
    }

    function toggleFilter(btn) {
      if (btn.classList.contains('bg-secondary-container')) {
        btn.classList.remove('bg-secondary-container', 'text-white', 'border-secondary-container', 'font-bold');
        btn.classList.add('bg-surface-container', 'text-on-surface-variant', 'border-outline-variant');
        btn.textContent = btn.textContent.replace('* ', '');
      } else {
        btn.classList.add('bg-secondary-container', 'text-white', 'border-secondary-container', 'font-bold');
        btn.classList.remove('bg-surface-container', 'text-on-surface-variant', 'border-outline-variant');
        if (!btn.textContent.includes('*')) {
          btn.textContent = '* ' + btn.textContent.trim();
        }
      }
    }
